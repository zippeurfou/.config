# Private/secret configurations
zsh/.zprivate

# Generated files
zsh/.zsh_sessions/
zsh/.zcompdump*
zsh/.zshrc.backup
zsh/.zsh_history
pyrightconfig.json

# Third-party tools (not portable) — runtime state / credentials
act/
gcloud/
github-copilot/
nvm/
op/
iterm2/
cagent/
gws/
homebrew/
rclone/
twg/

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Neovim lazy.nvim plugin directory
nvim/lazy-lock.json

# Atuin
atuin/key

# Password manager sensitive data
pwmanager/.env

# herdr — runtime state, captured pane output, logs, and vendored plugins
# (session captures can contain secrets; plugins/github is reinstallable from plugins.json)
herdr/session.json
herdr/session-history.json
herdr/*.log
herdr/plugins/github/

# opencode — tool-managed / machine-specific (reinstallable, or external symlinks)
opencode/superpowers/
opencode/skill/gws-*
opencode/skill/twg/
opencode/skill/twg-*/

# opencode — empty/generated artifacts
opencode/download.html

# opencode — work-internal (repo is PUBLIC: keep Grubhub-internal tooling out)
opencode/command/1_1_notes.md
opencode/command/fill_search_wbr.md
opencode/command/interview_form.md
opencode/command/mbr_narrative.md
opencode/command/performance_review_format.md
